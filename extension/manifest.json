{
  "manifest_version": 3,
  "name": "ytdlp Downloader",
  "key": "",
  "version": "1.0.0",
  "description": "Detect current page URL and download media via yt-dlp. Supports YouTube, Facebook, Instagram, TikTok, and 1000+ sites.",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "ytdlp Downloader",
    "default_icon": "icons/icon.png"
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  }
}
